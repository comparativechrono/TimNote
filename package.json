{
  "name": "timnote",
  "version": "1.0.0",
  "private": true,
  "description": "Notes and to-do lists kept as plain text files in a folder you choose.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e.mjs && node test/e2e-features.mjs",
    "start": "node test/serve.mjs",
    "build:vendor": "node build/vendor.mjs",
    "build:icons": "node build/icons.mjs",
    "build:sw": "node build/sw.mjs",
    "build": "node build/vendor.mjs && node build/icons.mjs && node build/sw.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.70.0",
    "marked": "^18.1.3",
    "playwright-core": "^1.65.0"
  }
}
