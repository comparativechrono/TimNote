{
  "name": "TimNote",
  "short_name": "TimNote",
  "description": "Notes and to-do lists kept as plain text files in a folder you choose.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1d2a3a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "New note", "url": "./#/new/Blank" },
    { "name": "Today’s note", "url": "./#/today" },
    { "name": "To do", "url": "./#/list/todo" }
  ]
}
